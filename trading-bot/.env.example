DERIV_APP_ID=
DERIV_API_TOKEN=

# По умолчанию "Crash 900 Index". Чтобы переключиться на другой индекс
# (например, Crash 1000 Index) — впишите точное display_name сюда.
# Чтобы откатиться назад, просто уберите строку или верните "Crash 900 Index".
SYMBOL_DISPLAY_NAME=Crash 900 Index

RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=5
COOLDOWN_TICKS_AFTER_CRASH=20

# Параметры стохастика (доп. фильтр входа поверх EMA/ATR). Значения ниже —
# дефолт под Crash 900 Index. При смене инструмента (см. SYMBOL_DISPLAY_NAME)
# подберите заново через `npm run calibrate` и впишите сюда.
# STOCH_PERIOD=14
# STOCH_SMOOTH_K=3
# STOCH_SMOOTH_D=3
# STOCH_OVERBOUGHT=80

# Только для бэктеста/калибровки: сколько последних тиков истории подтягивать
BACKTEST_TICKS=5000
