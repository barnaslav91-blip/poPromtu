DERIV_APP_ID=
DERIV_API_TOKEN=

# По умолчанию "Crash 900 Index". Чтобы переключиться на другой индекс
# (например, Crash 1000 Index) — впишите точное display_name сюда.
# Чтобы откатиться назад, просто уберите строку или верните "Crash 900 Index".
SYMBOL_DISPLAY_NAME=Crash 900 Index

RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=5
COOLDOWN_TICKS_AFTER_CRASH=20

# Параметры стохастика (доп. фильтр входа поверх EMA/направления). Значения
# ниже — дефолт под Crash 900 Index. При смене инструмента (см.
# SYMBOL_DISPLAY_NAME) подберите заново через `npm run calibrate` и впишите сюда.
# STOCH_PERIOD=14
# STOCH_SMOOTH_K=3
# STOCH_SMOOTH_D=3
# STOCH_OVERBOUGHT=80
# STOCH_OVERSOLD=20

# Направленческий фильтр: доля растущих тиков за окно. >= UP_THRESHOLD —
# разрешены только long, <= DOWN_THRESHOLD — только short, между ними бот
# не входит вообще (нет чёткого перевеса).
# TICK_DIRECTION_WINDOW=200
# TICK_DIRECTION_UP_THRESHOLD=0.55
# TICK_DIRECTION_DOWN_THRESHOLD=0.45

# Трейлинг-стоп (в единицах ATR от пика/дна с момента входа). Должен быть
# больше stopAtrMultiple (1.5 в коде) — иначе будет срабатывать раньше
# жёсткого стопа на бирже, а не подтягиваться по ходу движения.
# TRAIL_ATR_MULTIPLE=2.5

# Только для бэктеста/калибровки: сколько последних тиков истории подтягивать
BACKTEST_TICKS=5000
